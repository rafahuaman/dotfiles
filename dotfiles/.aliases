# Phoenix

alias phxs="mix phx.server"
alias phxc="iex -S mix"
alias phxdm="mix ecto.migrate"
alias phxdr="mix ecto.rollback"
alias phxr="mix phx.routes"

alias y="yarn"
alias yi="yarn install"
alias yif="yarn install --frozen-lockfile"
alias ys="yarn start"
alias ya="yarn add"
alias yr="yarn remove"
alias yad="yarn add -D"
alias yt="yarn test"
alias yo="yarn outdated"
alias yd="yarn dev"
alias yc="yarn commit"
alias yb="yarn build"


# pnpm
alias p="pnpm"
alias pa='pnpm add'
alias pad='pnpm add --save-dev'
alias pi='pnpm install'
alias pin='pnpm install'
alias pif='pnpm install --frozen-lockfile'
alias po='pnpm outdated'
alias pu='pnpm update'
alias puil='pnpm update --interactive'
alias puil='pnpm update --interactive --latest'
alias pr='pnpm run'
alias prun='pnpm run'
alias pex='pnpm exec'
alias pdx='pnpm dlx'
alias pd='pnpm dev'
alias pb='pnpm build'
alias ps='pnpm start'
alias psv='pnpm serve'
alias pt='pnpm test'
alias pl='pnpm lint'

# tilt
alias t="/opt/homebrew/bin/tilt"

# Ruby
alias rb='ruby'

# Bundler
alias rbb='bundle'
alias rbbc='bundle clean'
alias rbbe='bundle exec'
alias rbbi='bundle install --path vendor/bundle'
alias rbbl='bundle list'
alias rbbo='bundle open'
alias rbbp='bundle package'
alias rbbu='bundle update'

# rails
alias ror='bundle exec rails'
alias rorc='bundle exec rails console'
alias rordc='bundle exec rails dbconsole'
alias rordm='bundle exec rake db:migrate'
alias rordM='bundle exec rake db:migrate db:test:clone'
alias rordr='bundle exec rake db:rollback'
alias rorg='bundle exec rails generate'
alias rorl='tail -f "$(ruby-app-root)/log/development.log"'
alias rorlc='bundle exec rake log:clear'
alias rorp='bundle exec rails plugin'
alias rorr='bundle exec rails runner'
alias rors='bundle exec rails server'
alias rorsd='bundle exec rails server --debugger'
alias rorx='bundle exec rails destroy'
alias rortp='bundle exec rails db:test:prepare'
